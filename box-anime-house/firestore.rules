rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    match /anime/{animeId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['telegramId','referralCode','referralCount','activeSeconds','isAdmin']));
      allow delete: if isAdmin();
      match /history/{entryId} {
        allow read, write: if signedIn() && (request.auth.uid == uid || isAdmin());
      }
    }
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if false;
    }
    match /referrals/{referralId} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.inviteeUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}